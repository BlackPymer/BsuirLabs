Cell[BoxData[
 RowBox[{
  RowBox[{"secantMethod", "[", 
   RowBox[{"f_", ",", "a_", ",", "b_", ",", "eps_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x0", "=", "a"}], ",", 
      RowBox[{"x1", "=", "b"}], ",", "x2", ",", 
      RowBox[{"iter", "=", "0"}], ",", 
      RowBox[{"history", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{"True", ",", 
       RowBox[{
        RowBox[{"x2", "=", 
         RowBox[{"x1", "-", 
          RowBox[{
           RowBox[{"f", "[", "x1", "]"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x1", "-", "x0"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f", "[", "x1", "]"}], "-", 
              RowBox[{"f", "[", "x0", "]"}]}], ")"}]}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"iter", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"history", ",", 
          RowBox[{"{", 
           RowBox[{"iter", ",", 
            RowBox[{"N", "[", 
             RowBox[{"x2", ",", "6"}], "]"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"f", "[", "x2", "]"}], ",", "6"}], "]"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"x2", "-", "x1"}], "]"}], ",", "6"}], "]"}]}], "}"}]}],
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"x2", "-", "x1"}], "]"}], "<", "eps"}], ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"x0", "=", "x1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"x1", "=", "x2"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"x2", ",", "6"}], "]"}], ",", "iter", ",", "history"}], 
      "}"}]}]}], "]"}]}]], "Input",
