Cell[BoxData[
 RowBox[{
  RowBox[{"chordMethod", "[", 
   RowBox[{"f_", ",", "a_", ",", "b_", ",", "eps_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x0", "=", "a"}], ",", 
      RowBox[{"x1", "=", "b"}], ",", "x2", ",", "ll", ",", 
      RowBox[{"iter", "=", "0"}], ",", 
      RowBox[{"history", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{"True", ",", 
       RowBox[{
        RowBox[{"x2", "=", 
         RowBox[{"x1", "-", 
          RowBox[{
           RowBox[{"f", "[", "x1", "]"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x1", "-", "x0"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f", "[", "x1", "]"}], "-", 
              RowBox[{"f", "[", "x0", "]"}]}], ")"}]}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"iter", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ll", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x2", "-", "x1"}], ")"}], "^", "2"}], "/", 
          RowBox[{"Abs", "[", 
           RowBox[{"x2", "+", "x0", "-", 
            RowBox[{"2", "*", "x1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"history", ",", 
          RowBox[{"{", 
           RowBox[{"iter", ",", 
            RowBox[{"N", "[", 
             RowBox[{"x2", ",", "6"}], "]"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"f", "[", "x2", "]"}], ",", "6"}], "]"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{"ll", ",", "6"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ll", "<", "eps"}], ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"x0", "=", "x1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"x1", "=", "x2"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"x2", ",", "6"}], "]"}], ",", "iter", ",", "history"}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.999602856255435*^9, 3.999602937501141*^9}, {
   3.9996030971965733`*^9, 3.999603102613596*^9}, {3.99966222620644*^9, 
