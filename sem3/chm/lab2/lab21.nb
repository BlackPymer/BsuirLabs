Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"iterationMethod", "[", 
     RowBox[{"f_", ",", "phi_", ",", "a_", ",", "eps_", ",", "q_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x1", "=", "a"}], ",", "x2", ",", "iter", ",", 
        RowBox[{"history", "=", 
         RowBox[{"{", "}"}]}], ",", "d0"}], "}"}], ",", 
      RowBox[{
       RowBox[{"x2", "=", 
        RowBox[{"phi", "[", "x1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"d0", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"x2", "-", "x1"}], "]"}]}], ";", 
       RowBox[{"iter", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"history", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"iter", ",", 
           RowBox[{"N", "[", 
            RowBox[{"x2", ",", "6"}], "]"}], ",", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"f", "[", "x2", "]"}], ",", "6"}], "]"}], ",", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"q", "^", "iter"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "q"}], ")"}]}], "*", "d0"}], ",", "6"}], 
            "]"}]}], "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"q", "^", "iter"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "-", "q"}], ")"}]}], "*", "d0"}], ">=", "eps"}], 
         ",", 
         RowBox[{
          RowBox[{"x1", "=", "x2"}], ";", 
          RowBox[{"x2", "=", 
           RowBox[{"phi", "[", "x1", "]"}]}], ";", 
          RowBox[{"iter", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"history", ",", 
            RowBox[{"{", 
             RowBox[{"iter", ",", 
              RowBox[{"N", "[", 
