concept_bank
    => nrel_has: concept_bank_name;
    => nrel_has: concept_bank_address;
    => nrel_has: concept_bank_owner;;

concept_bank_client
    <- rrel_class: concept_bank;
    => nrel_has: concept_client_name;
    => nrel_has: concept_client_address;
    => nrel_has: concept_bank_account;;

concept_bank_filial
    <- rrel_class: concept_bank;
    => nrel_has: concept_filial_name;
    => nrel_has: concept_filial_address;;

concept_bank_account
    <- rrel_class: concept_bank;
    <- rrel_class: concept_bank_client;
    <- rrel_is_a: concept_abstract_object;
    <- rrel_is_a: concept_finance_instrument;
    => nrel_has: concept_account_type;
    => nrel_has: concept_balance;
    => nrel_has: concept_account_status;
    => nrel_has: concept_currency;
    => nrel_has: concept_account_number;;

concept_bank_employee
    <- rrel_class: concept_bank_filial;
    => nrel_has: concept_employee_name;
    => nrel_has: concept_employee_position;
    => nrel_has: concept_employee_filial;
    => nrel_has: concept_employee_salary;;

concept_debtor
    <- rrel_is_a: concept_bank_client;
    <- rrel_is_a: concept_loan_agreement_participant;
    <- rrel_class: concept_loan;
    => nrel_has: concept_debt_amount;
    => nrel_has: concept_repayment_term;;

concept_banking_domain
    <- rrel_is_a: concept_financial_system_domain;
    => nrel_has_child_domain: concept_lending_domain;
    => nrel_has_child_domain: concept_payment_operations_domain;;

concept_bank_account <- rrel_class: concept_banking_domain;;
concept_bank_client <- rrel_class: concept_banking_domain;;
concept_bank <- rrel_class: concept_banking_domain;;
concept_bank_filial <- rrel_class: concept_banking_domain;;
concept_bank_employee <- rrel_class: concept_banking_domain;;
concept_debtor <- rrel_class: concept_banking_domain;;
concept_loan <- rrel_class: concept_banking_domain;;
concept_currency <- rrel_class: concept_banking_domain;;

nrel_has
    <- rrel_class: concept_banking_domain;
    <- rrel_is_a: concept_non_role_relation;;

rrel_is_a
    <- rrel_class: concept_banking_domain;
    <- rrel_is_a: concept_role_relation;;

rrel_class
    <- rrel_class: concept_banking_domain;
    <- rrel_is_a: concept_role_relation;;