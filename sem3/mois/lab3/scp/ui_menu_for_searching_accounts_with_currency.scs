ui_menu_for_searching_accounts_with_currency
<- ui_user_command_class_atom;
<- ui_user_command_class_view_kb;
=> nrel_main_idtf:
	[Найти счета банка в заданной валюте]
	(*
		<- lang_ru;;
	*);
	[Search bank accounts in specified currency]
	(*
		<- lang_en;;
	*);
=> ui_nrel_command_template:
	[*
		action_search_accounts_with_currency _-> .._action
		(*
			_-> rrel_1:: ui_arg_1;;
			_-> rrel_2:: ui_arg_2;;
		*);;
		.._action <-_ action;;
	*];
=> ui_nrel_command_lang_template:
	[Найти счета банка $ui_arg_1 в валюте $ui_arg_2]
	(*
		<- lang_ru;;
	*);
	[Search accounts of $ui_arg_1 bank in $ui_arg_2 currency]
	(*
		<- lang_en;;
	*);;
