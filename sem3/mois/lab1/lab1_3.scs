[владеет аккаунтом*]
(* <- lang_ru;; *);

=> nrel_first_domain:
concept_system_participant;

=> nrel_second_domain:
concept_bank_account;;

nrel_has_owner
<- sc_node_non_role_relation;
=> nrel_main_idtf:
[имеет владельца*]
(* <- lang_ru;; *);

=> nrel_first_domain:
