structural_specification_of_bank_and_banking_products = [*
<- concept_structural_specification_of_subject_domain;;
subject_domain_of_bank_and_banking_products = [*
-> rrel_maximum_studied_object_class:
concept_financial_object;
concept_bank_account;
concept_bank;
concept_system_participant;
-> rrel_not_maximum_studied_object_class:
concept_bank_branch;
concept_currency;
concept_credit;
concept_borrower;
concept_bank_client;
concept_bank_employee;
concept_account_type;
-> rrel_explored_relation:
nrel_owns_account;
nrel_has_owner;
nrel_belongs_to_bank;
nrel_has_branch;
nrel_has_currency;
nrel_works_in;
nrel_is_borrower;
nrel_has_borrower;;
*];;
*];;

