=> nrel_is_borrower:
client_igor;;

structural_specification_of_banking_domain = [*
<- concept_structural_specification_of_subject_domain;;

subject_domain_of_banks_and_banking_services_russia = [*

-> rrel_maximum_studied_object_class:
concept_bank_account;
concept_bank;
concept_system_participant;

-> rrel_not_maximum_studied_object_class:
concept_bank_branch;
concept_bank_employee;
concept_account_type;

-> rrel_explored_relation:
nrel_owns_account;
nrel_has_owner;
nrel_belongs_to_bank;
nrel_is_borrower;
nrel_private_subject_domain;

*];;
*];;


set_theoretic_ontology_of_banking_domain = [*
<- concept_set_theoretic_ontology_of_subject_domain;;

concept_system_participant
=> nrel_subdividing: {
    concept_bank_employee;
    concept_bank_customer
};;

concept_bank
=> nrel_subdividing: {
    concept_bank_branch
};;

concept_bank_branch
=> nrel_inclusion:
concept_bank;;

concept_bank_account
<= nrel_private_subject_domain:
subject_domain_of_banks_and_banking_services_russia;;

*];;