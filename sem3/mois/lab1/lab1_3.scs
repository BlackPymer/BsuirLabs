subject_domain_of_banks_and_banking_services_russia
<- concept_subject_domain;
=> nrel_main_idtf:
[Предметная область банков и банковских услуг России]
(* <- lang_ru;; *);

=> nrel_ontology:
structural_specification_of_banking_domain
set_theoretic_ontology_of_banking_domain;;

concept_bank_account
<- sc_node_class;
=> nrel_main_idtf:
[банковский счёт]
(* <- lang_ru;; *);;

concept_bank
<- sc_node_class;
=> nrel_main_idtf:
[банк]
