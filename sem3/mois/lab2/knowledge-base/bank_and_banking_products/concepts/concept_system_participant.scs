concept_system_participant
<- sc_node_class;
=> nrel_main_idtf:
    [участник системы]
    (* <- lang_ru;; *);
=> nrel_main_idtf:
    [system participant]
    (* <- lang_en;; *);
<- rrel_explored_concept:
    subject_domain_of_bank_and_banking_products;
=> nrel_definition:
    [Участник системы — субъект, задействованный в функционировании банковской системы, который либо получает банковские продукты и услуги (клиент банка), либо обеспечивает их оказание (сотрудник банка).]
    (* <- lang_ru;; *);
=> nrel_definition:
    [System participant — an actor involved in the functioning of the banking system, which either receives banking products and services (bank client) or provides them (bank employee).]
    (* <- lang_en;; *);;
