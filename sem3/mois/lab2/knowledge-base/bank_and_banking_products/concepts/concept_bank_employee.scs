concept_bank_employee
<- sc_node_class;
=> nrel_main_idtf:
    [сотрудник банка]
    (* <- lang_ru;; *);
=> nrel_main_idtf:
    [bank employee]
    (* <- lang_en;; *);
<- rrel_explored_concept:
    subject_domain_of_bank_and_banking_products;
=> nrel_definition:
    [Сотрудник банка — работник банка, состоящий с ним в трудовых отношениях и выполняющий его функции: обслуживание клиентов, проведение банковских операций и предоставление банковских услуг.]
    (* <- lang_ru;; *);
=> nrel_definition:
    [Bank employee — a bank employee who is in an employment relationship with the bank and performs its functions: serving clients, conducting banking transactions and providing banking services.]
    (* <- lang_en;; *);;
