@search_credits_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._borrower <-_ concept_borrower);;
            nrel_has_borrower _-> (.._credit <=_ .._borrower);;
            @output_param1 = (.._credit <-_ concept_credit);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *)
};;

@search_credits_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска кредитов заданного заемщика]
    (*
        <- lang_ru;;
    *);;