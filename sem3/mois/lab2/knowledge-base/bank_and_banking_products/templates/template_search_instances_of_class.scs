@search_instances_of_class_template = {
    rrel_init_template:{
        rrel_template:[*
            @input_param1=(.._class <-_ sc_node_class);;
            @output_param1=(.._class _-> .._instance);;
        *];
        rrel_template_input_params:{
            @input_param1
        };
        rrel_template_output_params:{
            @output_param1
        }
    }(*<- nrel_search_set_template;;*)
};;

@search_instances_of_class_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска всех экземпляров заданного класса]
    (* <- lang_ru;; *);;
