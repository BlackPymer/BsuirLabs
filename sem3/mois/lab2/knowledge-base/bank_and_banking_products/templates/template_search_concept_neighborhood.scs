@search_concept_neighborhood_template = {
    rrel_init_template:{
        rrel_template:[*
            @input_param1=(.._concept <-_ sc_node_class);;
            nrel_main_idtf _-> (.._concept _=> .._idtf);;
            lang_ru _-> .._idtf;;
            nrel_inclusion _-> (.._parent _=> .._concept);;
            .._concept _-> .._instance;;
            nrel_first_domain _-> (.._relation _=> .._concept);;
            @output_param1=(.._concept _=> .._idtf);;
            @output_param2=(.._parent _=> .._concept);;
            @output_param3=(.._concept _-> .._instance);;
            @output_param4=(.._relation _=> .._concept);;
        *];
        rrel_template_input_params:{
            @input_param1
        };
        rrel_template_output_params:{
            @output_param1;
            @output_param2;
            @output_param3;
            @output_param4
        }
    }(*<- nrel_search_set_template;;*)
};;

@search_concept_neighborhood_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска фрагмента семантической окрестности понятия: основной идентификатор, включение, экземпляр и домен отношения]
    (* <- lang_ru;; *);
=> nrel_main_idtf:
    [Template for searching a fragment of the concept semantic neighborhood: main identifier, inclusion, instance and relation domain]
    (* <- lang_en;; *);;
