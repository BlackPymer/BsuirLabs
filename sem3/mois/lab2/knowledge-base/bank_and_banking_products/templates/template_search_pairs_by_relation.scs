@search_pairs_by_relation_template = {
    rrel_init_template:{
        rrel_template:[*
            @input_param1=(.._relation <-_ sc_node_non_role_relation);;
            .._relation _-> (.._source _=> .._target);;
            @output_param1=(.._source _=> .._target);;
        *];
        rrel_template_input_params:{
            @input_param1
        };
        rrel_template_output_params:{
            @output_param1
        }
    }(*<- nrel_search_set_template;;*)
};;

@search_pairs_by_relation_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска всех пар элементов, связанных заданным отношением]
    (* <- lang_ru;; *);;
