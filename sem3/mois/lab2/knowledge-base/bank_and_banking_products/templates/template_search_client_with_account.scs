@search_client_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._account <-_ concept_bank_account);;
            nrel_owns_account _-> (.._client _=> .._account);;
            @output_param1 = (.._client <-_ concept_bank_client);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_template;; *)
};;

@search_client_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска клиента с заданным банковским счетом]
    (*
        <- lang_ru;;
    *);;
