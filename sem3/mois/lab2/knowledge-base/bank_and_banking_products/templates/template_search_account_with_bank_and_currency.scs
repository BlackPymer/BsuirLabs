@search_account_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._bank <-_ concept_bank);;
            @input_param2 = (.._currency <-_ concept_currency);;
            nrel_belongs_to_bank _-> (.._bank <=_ .._account);;
            @output_param1 = (.._account <-_ concept_bank_account);;
            @output_param2 = (.._currency <-_ concept_currency);;
        *];
        rrel_template_input_params: {
            @input_param1;
            @input_param2
        };
        rrel_template_output_params: {
            @output_param1;
            @output_param2
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._account <-_ concept_bank_account);;
                @input_param2 = (.._currency <-_ concept_currency);;
                nrel_has_currency _-> (.._account _=> .._currency);;
                @output_param1 = (.._account <-_ concept_bank_account);;
            *];
            rrel_template_input_params: {
                @input_param1;
                @input_param2
            };
            rrel_template_output_params: {
                @output_param1
            }
        } (* <- nrel_search_set_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_account_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска банковского счета по банку и валюте]
    (*
        <- lang_ru;;
    *);;