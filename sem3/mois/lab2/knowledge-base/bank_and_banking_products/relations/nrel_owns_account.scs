nrel_owns_account
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [владеет банковским счётом*]
    (* <- lang_ru;; *);
=> nrel_main_idtf:
    [owns bank account*]
    (* <- lang_en;; *);
<- rrel_explored_relation:
    subject_domain_of_bank_and_banking_products;
=> nrel_first_domain:
    concept_system_participant;
=> nrel_second_domain:
    concept_bank_account;
=> nrel_definition:
    [владеет банковским счётом* — отношение между участником банковской системы и банковским счётом, принадлежащим ему и обслуживаемым в его интересах.]
    (* <- lang_ru;; *);
=> nrel_definition:
    [owns bank account* — a relation between a banking system participant and a bank account that belongs to them and is maintained in their interests.]
    (* <- lang_en;; *);;
