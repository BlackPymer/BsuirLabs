concept_bank_client
};;
concept_financial_object
=> nrel_subdividing: {
concept_bank_account;
concept_credit;
concept_bank_card
};;
concept_bank_branch
<= nrel_inclusion:
concept_bank;;
concept_bank_client
<= nrel_inclusion:
concept_system_participant;;
concept_bank_employee
<= nrel_inclusion:
concept_system_participant;;
concept_borrower
<= nrel_inclusion:
concept_bank_client;;
concept_bank_account
<= nrel_inclusion:
concept_financial_object;;
concept_credit
<= nrel_inclusion:
concept_financial_object;;
concept_bank_card
<= nrel_inclusion:
concept_financial_object;;
*];;
